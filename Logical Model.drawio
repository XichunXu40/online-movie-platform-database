        <mxCell id="3" value="Optional visual dependency view: arrows point from child FK relation to referenced parent PK relation." style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="900" height="24" as="geometry" />
