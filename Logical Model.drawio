        <mxCell id="4" value="&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;span style=&quot;border-bottom:1px solid #000000;&quot;&gt;PK / PK-FK&lt;/span&gt; = primary key or composite primary-key component &amp;nbsp;&amp;nbsp; &lt;span style=&quot;border-bottom:1px dashed #000000;&quot;&gt;FK only&lt;/span&gt; = foreign key that is not part of the primary key &amp;nbsp;&amp;nbsp; &lt;b&gt;U&lt;/b&gt; = unique / candidate key constraint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#666666;fontSize=11;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="270" height="96" as="geometry" />
